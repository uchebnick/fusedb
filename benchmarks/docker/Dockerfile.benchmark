FROM golang:1.25.13-alpine AS builder

WORKDIR /build

# Install build dependencies
RUN apk add --no-cache gcc musl-dev lz4-dev

# Cache both module dependency graphs. The benchmark module replaces FuseDB
# with its parent directory, matching the repository layout below.
COPY go.mod go.sum ./
COPY benchmarks/go.mod benchmarks/go.sum ./benchmarks/
RUN cd benchmarks && go mod download

# Copy source code
COPY . .

# Build the benchmark runner
RUN cd benchmarks && CGO_ENABLED=1 go build -o /build/benchmark-runner ./cmd/benchmark-runner

FROM alpine:latest

RUN apk add --no-cache lz4-libs ca-certificates

WORKDIR /app

COPY --from=builder /build/benchmark-runner .

# Create directories
RUN mkdir -p /data /config /results

ENTRYPOINT ["./benchmark-runner"]
