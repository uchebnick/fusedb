FROM golang:1.25.13-alpine AS builder

WORKDIR /build

# Install build dependencies
RUN apk add --no-cache gcc musl-dev

# Copy both module files so the benchmark module can resolve its parent.
COPY go.mod go.sum ./
COPY benchmarks/go.mod benchmarks/go.sum ./benchmarks/
RUN cd benchmarks && go mod download

# Copy source code
COPY . .

# Build the load generator
RUN cd benchmarks && CGO_ENABLED=0 go build -o /build/loadgen ./cmd/loadgen

FROM alpine:latest

RUN apk add --no-cache ca-certificates

WORKDIR /app

COPY --from=builder /build/loadgen .

CMD ["./loadgen"]
