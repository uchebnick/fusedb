FROM golang:1.25-alpine AS builder

WORKDIR /build

# Install build dependencies
RUN apk add --no-cache gcc musl-dev lz4-dev

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the server
RUN CGO_ENABLED=1 go build -o benchmark-server ./cmd/benchmark-server

FROM alpine:latest

RUN apk add --no-cache lz4-libs ca-certificates

WORKDIR /app

COPY --from=builder /build/benchmark-server .

# Create data directory
RUN mkdir -p /data/oneleaf

EXPOSE 8080 9090

CMD ["./benchmark-server"]
