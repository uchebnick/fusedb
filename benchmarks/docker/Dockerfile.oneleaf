FROM golang:1.25.13-alpine AS builder

WORKDIR /build

# Install build dependencies
RUN apk add --no-cache gcc musl-dev lz4-dev

# Copy both module files so the benchmark module can resolve its parent.
COPY go.mod go.sum ./
COPY benchmarks/go.mod benchmarks/go.sum ./benchmarks/
RUN cd benchmarks && go mod download

# Copy source code
COPY . .

# Build the server
RUN cd benchmarks && CGO_ENABLED=1 go build -o /build/benchmark-server ./cmd/benchmark-server

FROM alpine:latest

RUN apk add --no-cache lz4-libs ca-certificates

WORKDIR /app

COPY --from=builder /build/benchmark-server .

# Create data directory
RUN mkdir -p /data/oneleaf

EXPOSE 8080 9090

CMD ["./benchmark-server"]
