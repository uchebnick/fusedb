FROM golang:1.25-alpine AS builder

WORKDIR /build

# Install build dependencies
RUN apk add --no-cache gcc musl-dev

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the pebble server
RUN CGO_ENABLED=1 go build -o pebble-server ./cmd/pebble-server

FROM alpine:latest

RUN apk add --no-cache ca-certificates

WORKDIR /app

COPY --from=builder /build/pebble-server .

# Create data directory
RUN mkdir -p /data/pebble

EXPOSE 8080 9090

CMD ["./pebble-server"]
