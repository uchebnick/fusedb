FROM golang:1.25.13-alpine AS builder

WORKDIR /build

RUN apk add --no-cache gcc musl-dev

COPY go.mod go.sum ./
COPY benchmarks/go.mod benchmarks/go.sum ./benchmarks/
RUN cd benchmarks && go mod download

COPY . .

RUN cd benchmarks && CGO_ENABLED=1 go build -o /build/pebble-runner ./cmd/pebble-runner-metrics

FROM alpine:latest

RUN apk add --no-cache ca-certificates

WORKDIR /app

COPY --from=builder /build/pebble-runner .

RUN mkdir -p /data/pebble

EXPOSE 9090

CMD ["./pebble-runner"]
